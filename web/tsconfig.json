{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "paths": {
      "@shared/*": ["../shared/*"],
      "@onestock-public/design-system": ["./src/ds/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "env.d.ts", "../shared/**/*.ts"],
  "exclude": ["../shared/**/*.test.ts"]
}
