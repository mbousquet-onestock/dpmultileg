# --- Required in production (Vercel: Project > Settings > Environment Variables) ---
# 32-byte key (64 hex chars) encrypting the stored passwords and extension secrets: openssl rand -hex 32
CREDENTIALS_KEY=
# Signs the short-lived session JWT issued to the iframe: openssl rand -hex 32
JWT_SECRET=
# Bearer token for /api/admin/credentials (empty = admin API disabled)
ADMIN_TOKEN=

# --- Database ---
# Postgres (Vercel Marketplace > Neon sets DATABASE_URL / POSTGRES_URL). Empty = local SQLite file (DB_PATH).
DATABASE_URL=
DB_PATH=data/dpmultileg.sqlite

# --- Options ---
# Demo data instead of real OneStock API calls
MOCK_ONESTOCK=false
# Accept sessions without an extension signature for sites without stored secrets (dev only, defaults to true outside production)
ALLOW_UNSIGNED=false
# Origins allowed to embed the app (Express only; on Vercel edit the header in vercel.json)
FRAME_ANCESTORS='self' https://*.onestock-retail.com https://*.onestock-retail.dev
JWT_TTL_SECONDS=3600
REFERENTIAL_CACHE_SECONDS=300
PORT=3001
